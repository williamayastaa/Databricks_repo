{
  "datasets": [
    {
      "name": "sales_main",
      "displayName": "Sales Main Dataset",
      "queryLines": [
        "SELECT\n",
        "  f.sales_item_key,\n",
        "  f.order_id,\n",
        "  f.customer_key,\n",
        "  f.product_key,\n",
        "  f.date_key,\n",
        "  f.canal_venta,\n",
        "  f.estado_pedido,\n",
        "  f.cantidad,\n",
        "  f.precio_unitario,\n",
        "  f.descuento,\n",
        "  f.monto_total,\n",
        "  p.nombre_producto,\n",
        "  p.categoria,\n",
        "  p.subcategoria,\n",
        "  c.nombre,\n",
        "  c.apellido,\n",
        "  c.ciudad,\n",
        "  c.pais,\n",
        "  c.segmento,\n",
        "  d.anio,\n",
        "  d.mes,\n",
        "  d.nombre_mes,\n",
        "  d.dia_semana,\n",
        "  d.dia,\n",
        "  d.trimestre\n",
        "FROM\n",
        "  proyecto_final.gold.fact_ventas f\n",
        "    LEFT JOIN proyecto_final.gold.dim_producto p\n",
        "      ON f.product_key = p.product_key\n",
        "    LEFT JOIN proyecto_final.gold.dim_cliente c\n",
        "      ON f.customer_key = c.customer_key\n",
        "    LEFT JOIN proyecto_final.gold.dim_fecha d\n",
        "      ON f.date_key = d.date_key"
      ],
      "columns": [
        {
          "displayName": "Total Revenue",
          "description": "Total revenue from all orders",
          "expression": "SUM(monto_total)"
        },
        {
          "displayName": "Total Orders",
          "description": "Count of unique orders",
          "expression": "COUNT(DISTINCT order_id)"
        },
        {
          "displayName": "Total Units Sold",
          "description": "Total quantity of items sold",
          "expression": "SUM(cantidad)"
        },
        {
          "displayName": "Average Order Value",
          "description": "Average revenue per order",
          "expression": "SUM(monto_total) * 1.0 / COUNT(DISTINCT order_id)"
        },
        {
          "displayName": "Active Customers",
          "description": "Count of unique customers",
          "expression": "COUNT(DISTINCT customer_key)"
        }
      ],
      "catalog": "proyecto_final",
      "schema": "gold"
    }
  ],
